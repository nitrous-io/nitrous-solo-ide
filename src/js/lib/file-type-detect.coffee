App.FileTypeDetect =
  detect: (fileName) ->
    return 'text/plain' unless fileName
    fileName = fileName.match(/\/([^\/]+)$/)?[1] ? ''
    extension = fileName.match(/\.([^\.]+)$/)?[1]
    fileType = switch fileName.toLowerCase()
      when 'rakefile', 'rantfile', '.irbrc', 'irbrc', '.pryrc', 'pryrc', 'capfile', 'gemfile', 'guardfile', '.guardfile', 'vagrantfile', '.autotest', 'thorfile', 'podfile'
        'text/x-ruby'
      when 'configure'
        'text/x-sh'

    if extension && !fileType
      fileType = switch extension.toLowerCase()
        when 'rb', 'rbw', 'gemspec', 'builder', 'rxml', 'rjs', 'rake', 'rant', 'ru', 'thor', 'rabl', 'jbuilder'
          'text/x-ruby'
        when 'clj'
          'text/x-clojure'
        when 'erl'
          'text/x-erlang'
        when 'go'
          'text/x-go'
        when 'groovy'
          'text/x-groovy'
        when 'html'
          'text/html'
        when 'haml'
          'text/x-haml'
        when 'erb', 'rhtml'
          'application/x-erb'
        when 'css'
          'text/css'
        when 'hbs'
          'text/x-handlebars-template'
        when 'hs', 'lhs'
          'text/x-haskell'
        when 'jade'
          'text/x-jade'
        when 'java'
          'text/x-java'
        when 'jsp'
          'application/x-jsp'
        when 'j2'
          'text/x-jinja2'
        when 'jsx'
          'text/jsx'
        when 'js'
          'text/javascript'
        when 'json'
          'application/json'
        when 'jl'
          'text/x-julia'
        when 'ejs'
          'application/x-ejs'
        when 'coffee'
          'text/x-coffeescript'
        when 'less'
          'text/x-less'
        when 'markdown', 'md'
          'text/x-markdown'
        when 'c', 'h'
          'text/x-csrc'
        when 'cpp', 'hpp'
          'text/x-c++src'
        when 'diff'
          'text/x-diff'
        when 'lua'
          'text/x-lua'
        when 'sql', 'mysql'
          'text/x-sql'
        when 'rs'
          'text/x-rustsrc'
        when 'ml', 'mli', 'mll', 'mly'
          'text/x-ocaml'
        when 'pl'
          'text/x-perl'
        when 'php'
          'application/x-httpd-php'
        when 'py'
          'text/x-python'
        when 'r'
          'text/x-rsrc'
        when 'scala'
          'text/x-scala'
        when 'scm'
          'text/x-scheme'
        when 'scss'
          'text/x-scss'
        when 'sass'
          'text/x-sass'
        when 'sh'
          'text/x-sh'
        when 'slim', 'emblem'
          'text/x-slim'
        when 'styl'
          'text/x-styl'
        when 'ts'
          'application/typescript'
        when 'xml'
          'application/xml'
        when 'yml', 'yaml'
          'text/x-yaml'

    fileType || 'text/plain'


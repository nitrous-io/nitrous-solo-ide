.ui.card
  h2.card-header
    | Clone from GitHub
  .card-body
    .ui.input-group
      if view.content.error
        .notice-text
          i.fa.fa-warning
          '
          = view.content.error
      else
        if view.content.loaded
          .ui.select
            Ember.Select class='option-input' name='github-repo' content=view.content.repositories optionValuePath='content.git_url' optionLabelPath='content.name' value=selectedRepository prompt='Select Your GitHub Repository'
        else
          .status
            | Loading....
  .card-footer
    .right
      button.ui.btn click='didClickCancel target="view"' Cancel
      button.ui.btn.primary click='didClickOK target="view"' disabled={view.disableClone} Clone
